# Copy to api/.env and fill in. Nothing here is required for the local demo.

# Database: SQLite file by default. For Supabase use the pooler URL with the asyncpg driver:
# DATABASE_URL=postgresql+asyncpg://postgres.xxxx:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# Demo seller key the seller screens send (header X-Seller-Key). Change it before deploying.
SELLER_KEY=demo-seller-key

# AI step for messy Taglish comments (OpenRouter). Without a key, unclear comments go to "Needs you".
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-haiku-5.5

# Facebook Live comments (Meta Live Video API, Page access token). Optional.
META_PAGE_TOKEN=

# Base URL printed in QR codes (e.g. a tunnel or deployed URL). Empty = this laptop's LAN address.
PUBLIC_WEB_URL=

# Where the web app is served from when it is deployed separately (CORS). Comma-separated.
WEB_ORIGIN=http://localhost:5173

# Mock QR Ph gateway webhook signing secret
GATEWAY_WEBHOOK_SECRET=mockpay-dev-secret

# Queue timing defaults (the seller can change them in Settings)
HOLD_MINUTES=15
PAY_WINDOW_HOURS=24
